{
  "expo": {
    "name": "NutriSnap AI",
    "slug": "nutrisnap-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FF"
    },
